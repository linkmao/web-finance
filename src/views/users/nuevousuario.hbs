<form action="/api/auth/signup" method="POST">
  <input type="text" placeholder="Nombres" name="name" required>
  <input type="text" placeholder="Apellidos" name="lastName" required >
  <input type="email" placeholder="e-mail" name="email" required>
  <input type="text" placeholder="nombre usuario" name="userName" required>
  <input type="password" placeholder="contraseña" name="pass" required>
  <input type="password" placeholder="repite contraseña" name = "pass2" required>
  <button type="submit">Crea cuenta</button>
</form>